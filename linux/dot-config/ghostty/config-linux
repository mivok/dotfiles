# Prevent a white flash when making new splits on linux
window-theme = dark

# Ctrl-shift prefix for splits on linux
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+-=new_split:down

# Rename tab
keybind = ctrl+shift+r=prompt_tab_title

# Tab overview (expose)
keybind = ctrl+shift+arrow_up=toggle_tab_overview
